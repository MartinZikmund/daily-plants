{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:8080",
      "sslPort": 0
    }
  },
  "profiles": {
    // This profile is first in order for dotnet run to pick it up by default
    "DailyPlants (WebAssembly)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5000",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "DailyPlants (WebAssembly IIS Express)": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    // Packaged is listed first so `dotnet run -f net10.0-windows10.0.26100` defaults to it.
    "DailyPlants (WinAppSDK Packaged)": {
      "commandName": "MsixPackage",
      "compatibleTargetFramework": "windows"
    },
    // Unpackaged run for the WinAppSDK head. Explicit opt-in: select it and build unpackaged with
    // `dotnet run -f net10.0-windows10.0.26100 -p:WindowsPackageType=None --launch-profile "DailyPlants (WinAppSDK Unpackaged)"`.
    "DailyPlants (WinAppSDK Unpackaged)": {
      "commandName": "Project",
      "compatibleTargetFramework": "windows"
    },
    "DailyPlants (Desktop)": {
      "commandName": "Project",
      "compatibleTargetFramework": "desktop"
    },
    "DailyPlants (Desktop WSL2)": {
      "commandName": "WSL2",
      "commandLineArgs": "{ProjectDir}/bin/Debug/net9.0-desktop/DailyPlants.dll",
      "distributionName": "",
      "compatibleTargetFramework": "desktop"
    }
  }
}
