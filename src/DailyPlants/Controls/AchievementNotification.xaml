<UserControl x:Class="DailyPlants.Controls.AchievementNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:DailyPlants.Converters"
             xmlns:helpers="using:DailyPlants.Helpers">

    <Grid x:Name="RootGrid"
          Visibility="Collapsed"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="0,16,0,0"
          AutomationProperties.LiveSetting="Assertive">

        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="-100" />
        </Grid.RenderTransform>

        <Border Background="{ThemeResource DpSurfaceBrush}"
                BorderBrush="{ThemeResource DpHairlineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                MinWidth="300"
                MaxWidth="400">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Achievement Icon -->
                <Border x:Name="IconBorder"
                        Grid.Column="0"
                        Width="56" Height="56"
                        CornerRadius="28">
                    <BitmapIcon x:Name="AchievementIcon"
                               ShowAsMonochrome="False"
                               Width="32" Height="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Achievement Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{helpers:Localize Key=Achievement_Unlocked}"
                               Style="{StaticResource DpOverlineTextBlockStyle}"
                               Foreground="{ThemeResource DpGreenInkBrush}" />
                    <TextBlock x:Name="AchievementName"
                               Style="{StaticResource DpBodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AchievementDescription"
                               Style="{StaticResource DpCaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               MaxLines="2" />
                </StackPanel>

                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Click="CloseButton_Click"
                        Width="32" Height="32"
                        Padding="0"
                        Background="Transparent"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{helpers:Localize Key=Common_Close}"
                        AutomationProperties.AutomationId="AchievementNotificationCloseButton">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>

</UserControl>
