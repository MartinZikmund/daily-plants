<UserControl
    x:Class="DailyPlants.Controls.ResourcesTeaser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DailyPlants.Helpers"
    xmlns:vm="using:DailyPlants.ViewModels">

    <!--
        The three newest posts across all three feeds, at the foot of the Diary page.
        Stays collapsed until there is something to show, so the day never ends in a hole.
    -->
    <StackPanel Margin="0,24,0,0" Visibility="{x:Bind ViewModel.ShowStrip, Mode=OneWay}">

        <Grid Margin="0,0,0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource DpOverlineTextBlockStyle}"
                Text="{helpers:Localize Key=Resources_TeaserHeader}" />
            <Rectangle
                Grid.Column="1"
                Height="1"
                VerticalAlignment="Center"
                Fill="{ThemeResource DpHairlineBrush}" />
            <HyperlinkButton
                Grid.Column="2"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="DiaryResourcesSeeMoreButton"
                Command="{x:Bind ViewModel.OpenResourcesCommand}"
                Content="{helpers:Localize Key=Resources_SeeMore}" />
        </Grid>

        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>

                <!--  A copy of the Resources page's FeedCardTemplate: keep the two in step  -->
                <DataTemplate x:DataType="vm:FeedItemViewModel">
                    <Button
                        MinHeight="84"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AutomationName}"
                        Command="{x:Bind OpenCommand}"
                        Style="{StaticResource DpFeedCardButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Localize Key=Resources_OpenInBrowser}">
                        <Grid Padding="12" ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Placeholder behind the image: a remote thumbnail may be slow, missing or refused  -->
                            <Border
                                Width="112"
                                Height="63"
                                VerticalAlignment="Top"
                                Background="{ThemeResource DpHairlineBrush}"
                                CornerRadius="8">
                                <Image
                                    Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind HasThumbnail}" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource DpOverlineTextBlockStyle}" Text="{x:Bind KindText}" />
                                <TextBlock
                                    Foreground="{ThemeResource DpInkBrush}"
                                    MaxLines="2"
                                    Style="{StaticResource DpBodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource DpCaptionTextBlockStyle}"
                                    Text="{x:Bind Summary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasSummary}" />
                                <TextBlock
                                    Foreground="{ThemeResource DpGreenInkBrush}"
                                    Style="{StaticResource DpCaptionTextBlockStyle}"
                                    Text="{x:Bind PublishedText}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
