  <!-- Daily Dozen Items -->
  <data name="DD_Beans" xml:space="preserve">
    <value>Legumi</value>
  </data>
  <data name="DD_Beans_Serving_Imperial" xml:space="preserve">
    <value>1/2 tazza cotti o 1/4 di tazza di hummus</value>
  </data>
  <data name="DD_Beans_Serving_Metric" xml:space="preserve">
    <value>100 g cotti o 70 g di hummus</value>
  </data>
  <data name="DD_Beans_Desc" xml:space="preserve">
    <value>Legumi inclusi fagioli, lenticchie, ceci, tofu, tempeh e hummus. Le arachidi contano come frutta a guscio, i fagiolini e i piselli mangiatutto come altre verdure.</value>
  </data>
  <data name="DD_Beans_Benefits" xml:space="preserve">
    <value>Ottima fonte di proteine, fibre e carboidrati complessi. Uno studio di modellizzazione basato sui dati del Global Burden of Disease ha rilevato che mangiare più legumi offriva il maggiore guadagno di aspettativa di vita tra tutti i gruppi alimentari.</value>
  </data>
  <data name="DD_Berries" xml:space="preserve">
    <value>Frutti di bosco</value>
  </data>
  <data name="DD_Berries_Serving_Imperial" xml:space="preserve">
    <value>1/2 tazza freschi/surgelati o 1/4 di tazza secchi</value>
  </data>
  <data name="DD_Berries_Serving_Metric" xml:space="preserve">
    <value>70 g freschi/congelati o 40 g disidratati</value>
  </data>
  <data name="DD_Berries_Desc" xml:space="preserve">
    <value>Qualsiasi piccolo frutto commestibile, inclusi ciliegie, uva, uvetta e kumquat</value>
  </data>
  <data name="DD_Berries_Benefits" xml:space="preserve">
    <value>Il pi&#249; alto contenuto di antiossidanti tra tutta la frutta. Associati a una vita pi&#249; lunga e a benefici cognitivi.</value>
  </data>
  <data name="DD_OtherFruits" xml:space="preserve">
    <value>Altri frutti</value>
  </data>
  <data name="DD_OtherFruits_Serving_Imperial" xml:space="preserve">
    <value>1 frutto medio o 1/4 di tazza di frutta secca</value>
  </data>
  <data name="DD_OtherFruits_Serving_Metric" xml:space="preserve">
    <value>1 frutto medio o 40 g di frutta secca</value>
  </data>
  <data name="DD_OtherFruits_Desc" xml:space="preserve">
    <value>Frutta diversa dai frutti di bosco</value>
  </data>
  <data name="DD_OtherFruits_Benefits" xml:space="preserve">
    <value>Ricchi di vitamine, minerali e fibre. Essenziali per la salute generale.</value>
  </data>
  <data name="DD_Greens" xml:space="preserve">
    <value>Verdure verdi</value>
  </data>
  <data name="DD_Greens_Serving_Imperial" xml:space="preserve">
    <value>1 tazza da crude o 1/2 tazza da cotte</value>
  </data>
  <data name="DD_Greens_Serving_Metric" xml:space="preserve">
    <value>60 g da crude o 90 g da cotte</value>
  </data>
  <data name="DD_Greens_Desc" xml:space="preserve">
    <value>Verdure a foglia verde scuro</value>
  </data>
  <data name="DD_Greens_Benefits" xml:space="preserve">
    <value>Le pi&#249; associate a una vita pi&#249; lunga tra le verdure. Ricche di nitrati che migliorano la funzione muscolare e arteriosa.</value>
  </data>
  <data name="DD_Cruciferous" xml:space="preserve">
    <value>Verdure crucifere</value>
  </data>
  <data name="DD_Cruciferous_Serving_Imperial" xml:space="preserve">
    <value>1/2 tazza tritate o 1 cucchiaio di rafano</value>
  </data>
  <data name="DD_Cruciferous_Serving_Metric" xml:space="preserve">
    <value>90 g tritate o 1 cucchiaio di rafano</value>
  </data>
  <data name="DD_Cruciferous_Desc" xml:space="preserve">
    <value>Broccoli, cavolfiore, cavolo, cavolo riccio, ecc.</value>
  </data>
  <data name="DD_Cruciferous_Benefits" xml:space="preserve">
    <value>Contengono sulforafano che potenzia il sistema immunitario e gli enzimi di disintossicazione del fegato.</value>
  </data>
  <data name="DD_OtherVegetables" xml:space="preserve">
    <value>Altre verdure</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Imperial" xml:space="preserve">
    <value>1/2 tazza di verdure non a foglia</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Metric" xml:space="preserve">
    <value>90 g di verdure non a foglia</value>
  </data>
  <data name="DD_OtherVegetables_Desc" xml:space="preserve">
    <value>Qualsiasi altra verdura, inclusi pomodori, funghi e fagiolini</value>
  </data>
  <data name="DD_OtherVegetables_Benefits" xml:space="preserve">
    <value>Nutrienti diversificati e fibre. Essenziali per una dieta equilibrata.</value>
  </data>
  <data name="DD_Flaxseed" xml:space="preserve">
    <value>Semi di lino</value>
  </data>
  <data name="DD_Flaxseed_Serving" xml:space="preserve">
    <value>1 cucchiaio di semi macinati</value>
  </data>
  <data name="DD_Flaxseed_Desc" xml:space="preserve">
    <value>Semi di lino macinati</value>
  </data>
  <data name="DD_Flaxseed_Benefits" xml:space="preserve">
    <value>La fonte pi&#249; ricca di lignani e omega-3 ALA. Benefici per la salute del cuore e l'equilibrio ormonale.</value>
  </data>
  <data name="DD_Nuts" xml:space="preserve">
    <value>Frutta a guscio e semi</value>
  </data>
  <data name="DD_Nuts_Serving_Imperial" xml:space="preserve">
    <value>1/4 di tazza di frutta a guscio o semi, o 2 cucchiai di burro di frutta a guscio o semi</value>
  </data>
  <data name="DD_Nuts_Serving_Metric" xml:space="preserve">
    <value>30 g di frutta a guscio o semi, o 2 cucchiai di burro di frutta a guscio o semi</value>
  </data>
  <data name="DD_Nuts_Desc" xml:space="preserve">
    <value>Tutta la frutta a guscio e i semi, comprese le arachidi. Castagne e noci di cocco non contano.</value>
  </data>
  <data name="DD_Nuts_Benefits" xml:space="preserve">
    <value>Il Global Burden of Disease Study ha classificato lo scarso consumo di frutta a guscio e semi come il terzo principale rischio alimentare di morte e disabilità nel mondo.</value>
  </data>
  <data name="DD_Herbs" xml:space="preserve">
    <value>Erbe e spezie</value>
  </data>
  <data name="DD_Herbs_Serving" xml:space="preserve">
    <value>&#188; di cucchiaino di curcuma</value>
  </data>
  <data name="DD_Herbs_Desc" xml:space="preserve">
    <value>Soprattutto curcuma, più qualsiasi altra erba e spezia senza sale che ti piace</value>
  </data>
  <data name="DD_Herbs_Benefits" xml:space="preserve">
    <value>Potenti propriet&#224; antinfiammatorie e antiossidanti.</value>
  </data>
  <data name="DD_WholeGrains" xml:space="preserve">
    <value>Cereali integrali</value>
  </data>
  <data name="DD_WholeGrains_Serving_Imperial" xml:space="preserve">
    <value>1/2 tazza di cereali caldi o 1 fetta di pane integrale</value>
  </data>
  <data name="DD_WholeGrains_Serving_Metric" xml:space="preserve">
    <value>100 g di cereali caldi o 1 fetta di pane integrale</value>
  </data>
  <data name="DD_WholeGrains_Desc" xml:space="preserve">
    <value>Preferibilmente cereali integrali in chicco. Pane e cereali devono essere integrali al 100%.</value>
  </data>
  <data name="DD_WholeGrains_Benefits" xml:space="preserve">
    <value>L'alto contenuto di fibre favorisce la salute intestinale e la stabilit&#224; della glicemia.</value>
  </data>
  <data name="DD_Beverages" xml:space="preserve">
    <value>Bevande</value>
  </data>
  <data name="DD_Beverages_Serving_Imperial" xml:space="preserve">
    <value>12 oz di acqua, tè o caffè</value>
  </data>
  <data name="DD_Beverages_Serving_Metric" xml:space="preserve">
    <value>350 ml di acqua, tè o caffè</value>
  </data>
  <data name="DD_Beverages_Desc" xml:space="preserve">
    <value>Acqua, tè verde, tè di ibisco, caffè e altre bevande non zuccherate</value>
  </data>
  <data name="DD_Beverages_Benefits" xml:space="preserve">
    <value>Una corretta idratazione &#232; essenziale per tutte le funzioni corporee.</value>
  </data>
  <data name="DD_Exercise" xml:space="preserve">
    <value>Attivit&#224; fisica</value>
  </data>
  <data name="DD_Exercise_Serving" xml:space="preserve">
    <value>90 min moderata o 40 min intensa</value>
  </data>
  <data name="DD_Exercise_Desc" xml:space="preserve">
    <value>Attività fisica quotidiana, che puoi suddividere nell'arco della giornata</value>
  </data>
  <data name="DD_Exercise_Benefits" xml:space="preserve">
    <value>Essenziale per la longevità e la salute in generale. È stato dimostrato che l'allenamento di forza aumenta i livelli di NAD+ nei muscoli fino al 127%.</value>
  </data>
  <data name="DD_VitaminB12" xml:space="preserve">
    <value>Vitamina B12</value>
  </data>
  <data name="DD_VitaminB12_Serving" xml:space="preserve">
    <value>Almeno 2000 mcg settimanali o 50 mcg giornalieri</value>
  </data>
  <data name="DD_VitaminB12_Desc" xml:space="preserve">
    <value>Un integratore di cianocobalamina, idealmente masticabile, sublinguale o liquido, assunto a stomaco vuoto. Monitorato per tua comodità; non conta nel totale giornaliero né nella serie.</value>
  </data>
  <data name="DD_VitaminB12_Benefits" xml:space="preserve">
    <value>Essenziale per la funzione nervosa e la formazione dei globuli rossi. Necessaria nella dieta a base vegetale.</value>
