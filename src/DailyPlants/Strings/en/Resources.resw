  <data name="TT_PreloadWater_Caution" xml:space="preserve">
    <value>Never drink more than 3 cups (about 700 ml) of fluid an hour.</value>
  </data>
  <data name="TT_Vinegar_Caution" xml:space="preserve">
    <value>Never drink vinegar straight. If you want to drink it, mix it into a glass of water and rinse your mouth with water afterward to protect your tooth enamel.</value>
  </data>
  <data name="TT_GreenTea_Caution" xml:space="preserve">
