  <!-- Daily Dozen Items -->
  <data name="DD_Beans" xml:space="preserve">
    <value>Beans</value>
  </data>
  <data name="DD_Beans_Serving_Imperial" xml:space="preserve">
    <value>1/2 cup cooked or 1/4 cup hummus</value>
  </data>
  <data name="DD_Beans_Serving_Metric" xml:space="preserve">
    <value>100 g cooked or 70 g hummus</value>
  </data>
  <data name="DD_Beans_Desc" xml:space="preserve">
    <value>Legumes including beans, lentils, chickpeas, tofu, tempeh and hummus. Peanuts count as nuts, and green beans and snap peas as other vegetables.</value>
  </data>
  <data name="DD_Beans_Benefits" xml:space="preserve">
    <value>Excellent source of protein, fiber, and complex carbohydrates. A modeling study based on Global Burden of Disease data found that eating more legumes offered the largest lifespan gains of any food group.</value>
  </data>
  <data name="DD_Berries" xml:space="preserve">
    <value>Berries</value>
  </data>
  <data name="DD_Berries_Serving_Imperial" xml:space="preserve">
    <value>1/2 cup fresh/frozen or 1/4 cup dried</value>
  </data>
  <data name="DD_Berries_Serving_Metric" xml:space="preserve">
    <value>70 g fresh/frozen or 40 g dried</value>
  </data>
  <data name="DD_Berries_Desc" xml:space="preserve">
    <value>Any small edible fruit, including cherries, grapes, raisins and kumquats</value>
  </data>
  <data name="DD_Berries_Benefits" xml:space="preserve">
    <value>Highest antioxidant content of all fruits. Associated with longer lifespan and cognitive benefits.</value>
  </data>
  <data name="DD_OtherFruits" xml:space="preserve">
    <value>Other Fruits</value>
  </data>
  <data name="DD_OtherFruits_Serving_Imperial" xml:space="preserve">
    <value>1 medium fruit or 1/4 cup dried</value>
  </data>
  <data name="DD_OtherFruits_Serving_Metric" xml:space="preserve">
    <value>1 medium fruit or 40 g dried</value>
  </data>
  <data name="DD_OtherFruits_Desc" xml:space="preserve">
    <value>Fruits other than berries</value>
  </data>
  <data name="DD_OtherFruits_Benefits" xml:space="preserve">
    <value>Rich in vitamins, minerals, and fiber. Essential for overall health.</value>
  </data>
  <data name="DD_Greens" xml:space="preserve">
    <value>Greens</value>
  </data>
  <data name="DD_Greens_Serving_Imperial" xml:space="preserve">
    <value>1 cup raw or 1/2 cup cooked</value>
  </data>
  <data name="DD_Greens_Serving_Metric" xml:space="preserve">
    <value>60 g raw or 90 g cooked</value>
  </data>
  <data name="DD_Greens_Desc" xml:space="preserve">
    <value>Dark leafy green vegetables</value>
  </data>
  <data name="DD_Greens_Benefits" xml:space="preserve">
    <value>Most associated with longer lifespan among vegetables. Rich in nitrates that improve muscle and artery function.</value>
  </data>
  <data name="DD_Cruciferous" xml:space="preserve">
    <value>Cruciferous Vegetables</value>
  </data>
  <data name="DD_Cruciferous_Serving_Imperial" xml:space="preserve">
    <value>1/2 cup chopped or 1 tbsp horseradish</value>
  </data>
  <data name="DD_Cruciferous_Serving_Metric" xml:space="preserve">
    <value>90 g chopped or 1 tbsp horseradish</value>
  </data>
  <data name="DD_Cruciferous_Desc" xml:space="preserve">
    <value>Broccoli, cauliflower, cabbage, kale, etc.</value>
  </data>
  <data name="DD_Cruciferous_Benefits" xml:space="preserve">
    <value>Contains sulforaphane which boosts immune function and liver detox enzymes.</value>
  </data>
  <data name="DD_OtherVegetables" xml:space="preserve">
    <value>Other Vegetables</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Imperial" xml:space="preserve">
    <value>1/2 cup non-leafy vegetables</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Metric" xml:space="preserve">
    <value>90 g non-leafy vegetables</value>
  </data>
  <data name="DD_OtherVegetables_Desc" xml:space="preserve">
    <value>Any other vegetables, including tomatoes, mushrooms and green beans</value>
  </data>
  <data name="DD_OtherVegetables_Benefits" xml:space="preserve">
    <value>Diverse nutrients and fiber. Essential for a balanced diet.</value>
  </data>
  <data name="DD_Flaxseed" xml:space="preserve">
    <value>Flaxseed</value>
  </data>
  <data name="DD_Flaxseed_Serving" xml:space="preserve">
    <value>1 tbsp ground</value>
  </data>
  <data name="DD_Flaxseed_Desc" xml:space="preserve">
    <value>Ground flaxseed</value>
  </data>
  <data name="DD_Flaxseed_Benefits" xml:space="preserve">
    <value>Richest source of lignans and omega-3 ALA. Benefits heart health and hormone balance.</value>
  </data>
  <data name="DD_Nuts" xml:space="preserve">
    <value>Nuts and Seeds</value>
  </data>
  <data name="DD_Nuts_Serving_Imperial" xml:space="preserve">
    <value>1/4 cup nuts or seeds, or 2 tbsp nut or seed butter</value>
  </data>
  <data name="DD_Nuts_Serving_Metric" xml:space="preserve">
    <value>30 g nuts or seeds, or 2 tbsp nut or seed butter</value>
  </data>
  <data name="DD_Nuts_Desc" xml:space="preserve">
    <value>All nuts and seeds, including peanuts. Chestnuts and coconuts don't count.</value>
  </data>
  <data name="DD_Nuts_Benefits" xml:space="preserve">
    <value>The Global Burden of Disease Study ranked eating too few nuts and seeds as the third-leading dietary risk for death and disability worldwide.</value>
  </data>
  <data name="DD_Herbs" xml:space="preserve">
    <value>Herbs and Spices</value>
  </data>
  <data name="DD_Herbs_Serving" xml:space="preserve">
    <value>1/4 tsp turmeric</value>
  </data>
  <data name="DD_Herbs_Desc" xml:space="preserve">
    <value>Especially turmeric, plus any other salt-free herbs and spices you enjoy</value>
  </data>
  <data name="DD_Herbs_Benefits" xml:space="preserve">
    <value>Powerful anti-inflammatory and antioxidant properties.</value>
  </data>
  <data name="DD_WholeGrains" xml:space="preserve">
    <value>Whole Grains</value>
  </data>
  <data name="DD_WholeGrains_Serving_Imperial" xml:space="preserve">
    <value>1/2 cup hot cereal or 1 slice whole grain bread</value>
  </data>
  <data name="DD_WholeGrains_Serving_Metric" xml:space="preserve">
    <value>100 g hot cereal or 1 slice whole grain bread</value>
  </data>
  <data name="DD_WholeGrains_Desc" xml:space="preserve">
    <value>Intact whole grains preferred. Breads and cereals should be 100% whole grain.</value>
  </data>
  <data name="DD_WholeGrains_Benefits" xml:space="preserve">
    <value>High fiber content supports gut health and stable blood sugar.</value>
  </data>
  <data name="DD_Beverages" xml:space="preserve">
    <value>Beverages</value>
  </data>
  <data name="DD_Beverages_Serving_Imperial" xml:space="preserve">
    <value>12 oz water, tea, or coffee</value>
  </data>
  <data name="DD_Beverages_Serving_Metric" xml:space="preserve">
    <value>350 ml water, tea, or coffee</value>
  </data>
  <data name="DD_Beverages_Desc" xml:space="preserve">
    <value>Water, green tea, hibiscus tea, coffee and other unsweetened drinks</value>
  </data>
  <data name="DD_Beverages_Benefits" xml:space="preserve">
    <value>Proper hydration is essential for all body functions.</value>
  </data>
  <data name="DD_Exercise" xml:space="preserve">
    <value>Exercise</value>
  </data>
  <data name="DD_Exercise_Serving" xml:space="preserve">
    <value>90 min moderate or 40 min vigorous</value>
  </data>
  <data name="DD_Exercise_Desc" xml:space="preserve">
    <value>Daily physical activity, which you can split up over the day</value>
  </data>
  <data name="DD_Exercise_Benefits" xml:space="preserve">
    <value>Essential for longevity and overall health. Resistance training has been shown to raise muscle NAD+ levels by as much as 127%.</value>
  </data>
  <data name="DD_VitaminB12" xml:space="preserve">
    <value>Vitamin B12</value>
  </data>
  <data name="DD_VitaminB12_Serving" xml:space="preserve">
    <value>At least 2000 mcg weekly or 50 mcg daily</value>
  </data>
  <data name="DD_VitaminB12_Desc" xml:space="preserve">
    <value>A cyanocobalamin supplement, ideally chewable, sublingual or liquid and taken on an empty stomach. Tracked for your convenience; it doesn't count toward your daily total or streak.</value>
  </data>
  <data name="DD_VitaminB12_Benefits" xml:space="preserve">
    <value>Essential for nerve function and red blood cell formation. Required on plant-based diet.</value>
  </data>

  <!-- Twenty-One Tweaks Items -->
  <data name="TT_PreloadWater" xml:space="preserve">
    <value>Preload Water</value>
  </data>
  <data name="TT_PreloadWater_Desc_Imperial" xml:space="preserve">
    <value>2 cups before each meal</value>
  </data>
  <data name="TT_PreloadWater_Desc_Metric" xml:space="preserve">
    <value>500 ml before each meal</value>
  </data>
  <data name="TT_PreloadWater_LongDesc" xml:space="preserve">
    <value>Drink 2 cups (about 500 ml) of cool or cold unflavored water before each meal.</value>
  </data>
  <data name="TT_PreloadWater_Benefits" xml:space="preserve">
    <value>Boosts metabolism and helps feel full, reducing calorie intake.</value>
  </data>
  <data name="TT_NegativeCalorie" xml:space="preserve">
    <value>Negative Calorie Preload</value>
  </data>
  <data name="TT_NegativeCalorie_Desc" xml:space="preserve">
    <value>Start with apple, salad, or soup</value>
  </data>
  <data name="TT_NegativeCalorie_LongDesc" xml:space="preserve">
    <value>Start each meal with an apple, or a whole-food soup or salad with fewer than 100 calories per cup (about 240 ml).</value>
  </data>
  <data name="TT_NegativeCalorie_Benefits" xml:space="preserve">
    <value>Reduces overall calorie consumption while adding nutrition.</value>
  </data>
