  </data>
  <data name="TT_Undistracted_LongDesc" xml:space="preserve">
    <value>用餐時不分心</value>
  </data>
  <data name="TT_Undistracted_Benefits" xml:space="preserve">
    <value>專心進食能更好地控制份量並增加滿足感。</value>
  </data>
  <data name="TT_TwentyMinute" xml:space="preserve">
