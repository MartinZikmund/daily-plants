  <!-- Daily Dozen Items -->
  <data name="DD_Beans" xml:space="preserve">
    <value>Légumineuses</value>
  </data>
  <data name="DD_Beans_Serving_Imperial" xml:space="preserve">
    <value>1/2 tasse cuit ou 1/4 tasse de houmous</value>
  </data>
  <data name="DD_Beans_Serving_Metric" xml:space="preserve">
    <value>100 g cuit ou 70 g de houmous</value>
  </data>
  <data name="DD_Beans_Desc" xml:space="preserve">
    <value>Légumineuses dont haricots, lentilles, pois chiches, tofu, tempeh et houmous. Les cacahuètes comptent comme des noix, les haricots verts et les pois gourmands comme d'autres légumes.</value>
  </data>
  <data name="DD_Beans_Benefits" xml:space="preserve">
    <value>Excellente source de protéines, de fibres et de glucides complexes. Une étude de modélisation fondée sur les données de la Global Burden of Disease a montré que manger plus de légumineuses offrait le plus grand gain d'espérance de vie de tous les groupes d'aliments.</value>
  </data>
  <data name="DD_Berries" xml:space="preserve">
    <value>Baies</value>
  </data>
  <data name="DD_Berries_Serving_Imperial" xml:space="preserve">
    <value>1/2 tasse fraîches/congelées ou 1/4 tasse séchées</value>
  </data>
  <data name="DD_Berries_Serving_Metric" xml:space="preserve">
    <value>70 g fraîches/congelées ou 40 g séchées</value>
  </data>
  <data name="DD_Berries_Desc" xml:space="preserve">
    <value>Tout petit fruit comestible, dont cerises, raisins, raisins secs et kumquats</value>
  </data>
  <data name="DD_Berries_Benefits" xml:space="preserve">
    <value>Teneur en antioxydants la plus élevée de tous les fruits. Associées à une plus grande longévité et à des bienfaits cognitifs.</value>
  </data>
  <data name="DD_OtherFruits" xml:space="preserve">
    <value>Autres fruits</value>
  </data>
  <data name="DD_OtherFruits_Serving_Imperial" xml:space="preserve">
    <value>1 fruit de taille moyenne ou 1/4 tasse séchés</value>
  </data>
  <data name="DD_OtherFruits_Serving_Metric" xml:space="preserve">
    <value>1 fruit de taille moyenne ou 40 g séchés</value>
  </data>
  <data name="DD_OtherFruits_Desc" xml:space="preserve">
    <value>Fruits autres que les baies</value>
  </data>
  <data name="DD_OtherFruits_Benefits" xml:space="preserve">
    <value>Riches en vitamines, minéraux et fibres. Essentiels pour une bonne santé générale.</value>
  </data>
  <data name="DD_Greens" xml:space="preserve">
    <value>Légumes verts</value>
  </data>
  <data name="DD_Greens_Serving_Imperial" xml:space="preserve">
    <value>1 tasse crus ou 1/2 tasse cuits</value>
  </data>
  <data name="DD_Greens_Serving_Metric" xml:space="preserve">
    <value>60 g crus ou 90 g cuits</value>
  </data>
  <data name="DD_Greens_Desc" xml:space="preserve">
    <value>Légumes verts à feuilles foncées</value>
  </data>
  <data name="DD_Greens_Benefits" xml:space="preserve">
    <value>Les plus associés à une plus grande longévité parmi les légumes. Riches en nitrates qui améliorent la fonction musculaire et artérielle.</value>
  </data>
  <data name="DD_Cruciferous" xml:space="preserve">
    <value>Légumes crucifères</value>
  </data>
  <data name="DD_Cruciferous_Serving_Imperial" xml:space="preserve">
    <value>1/2 tasse hachés ou 1 c. à soupe de raifort</value>
  </data>
  <data name="DD_Cruciferous_Serving_Metric" xml:space="preserve">
    <value>90 g hachés ou 1 c. à soupe de raifort</value>
  </data>
  <data name="DD_Cruciferous_Desc" xml:space="preserve">
    <value>Brocoli, chou-fleur, chou, kale, etc.</value>
  </data>
  <data name="DD_Cruciferous_Benefits" xml:space="preserve">
    <value>Contient du sulforaphane qui renforce le système immunitaire et les enzymes de détoxification du foie.</value>
  </data>
  <data name="DD_OtherVegetables" xml:space="preserve">
    <value>Autres légumes</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Imperial" xml:space="preserve">
    <value>1/2 tasse de légumes sans feuilles</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Metric" xml:space="preserve">
    <value>90 g de légumes sans feuilles</value>
  </data>
  <data name="DD_OtherVegetables_Desc" xml:space="preserve">
    <value>Tous les autres légumes, dont tomates, champignons et haricots verts</value>
  </data>
  <data name="DD_OtherVegetables_Benefits" xml:space="preserve">
    <value>Nutriments variés et fibres. Essentiels pour une alimentation équilibrée.</value>
  </data>
  <data name="DD_Flaxseed" xml:space="preserve">
    <value>Graines de lin</value>
  </data>
  <data name="DD_Flaxseed_Serving" xml:space="preserve">
    <value>1 c. à soupe moulues</value>
  </data>
  <data name="DD_Flaxseed_Desc" xml:space="preserve">
    <value>Graines de lin moulues</value>
  </data>
  <data name="DD_Flaxseed_Benefits" xml:space="preserve">
    <value>Source la plus riche en lignanes et en oméga-3 ALA. Bienfaits pour la santé cardiaque et l'équilibre hormonal.</value>
  </data>
  <data name="DD_Nuts" xml:space="preserve">
    <value>Noix et graines</value>
  </data>
  <data name="DD_Nuts_Serving_Imperial" xml:space="preserve">
    <value>1/4 tasse de noix ou de graines, ou 2 c. à soupe de beurre de noix ou de graines</value>
  </data>
  <data name="DD_Nuts_Serving_Metric" xml:space="preserve">
    <value>30 g de noix ou de graines, ou 2 c. à soupe de beurre de noix ou de graines</value>
  </data>
  <data name="DD_Nuts_Desc" xml:space="preserve">
    <value>Toutes les noix et graines, y compris les cacahuètes. Les châtaignes et les noix de coco ne comptent pas.</value>
  </data>
  <data name="DD_Nuts_Benefits" xml:space="preserve">
    <value>La Global Burden of Disease Study a classé le manque de noix et de graines au troisième rang des risques alimentaires de décès et d'invalidité dans le monde.</value>
  </data>
  <data name="DD_Herbs" xml:space="preserve">
    <value>Épices et herbes aromatiques</value>
  </data>
  <data name="DD_Herbs_Serving" xml:space="preserve">
    <value>1/4 c. à café de curcuma</value>
  </data>
  <data name="DD_Herbs_Desc" xml:space="preserve">
    <value>Surtout le curcuma, plus toutes les autres herbes et épices sans sel que vous aimez</value>
  </data>
  <data name="DD_Herbs_Benefits" xml:space="preserve">
    <value>Puissantes propriétés anti-inflammatoires et antioxydantes.</value>
  </data>
  <data name="DD_WholeGrains" xml:space="preserve">
    <value>Céréales complètes</value>
  </data>
  <data name="DD_WholeGrains_Serving_Imperial" xml:space="preserve">
    <value>1/2 tasse de céréales chaudes ou 1 tranche de pain complet</value>
  </data>
  <data name="DD_WholeGrains_Serving_Metric" xml:space="preserve">
    <value>100 g de céréales chaudes ou 1 tranche de pain complet</value>
  </data>
  <data name="DD_WholeGrains_Desc" xml:space="preserve">
    <value>Céréales complètes intactes de préférence. Les pains et céréales doivent être complets à 100%.</value>
  </data>
  <data name="DD_WholeGrains_Benefits" xml:space="preserve">
    <value>Haute teneur en fibres, favorisant la santé intestinale et une glycémie stable.</value>
  </data>
  <data name="DD_Beverages" xml:space="preserve">
    <value>Boissons</value>
  </data>
  <data name="DD_Beverages_Serving_Imperial" xml:space="preserve">
    <value>12 oz d'eau, thé ou café</value>
  </data>
  <data name="DD_Beverages_Serving_Metric" xml:space="preserve">
    <value>350 ml d'eau, thé ou café</value>
  </data>
  <data name="DD_Beverages_Desc" xml:space="preserve">
    <value>Eau, thé vert, thé d'hibiscus, café et autres boissons non sucrées</value>
  </data>
  <data name="DD_Beverages_Benefits" xml:space="preserve">
    <value>Une bonne hydratation est essentielle pour toutes les fonctions corporelles.</value>
  </data>
  <data name="DD_Exercise" xml:space="preserve">
    <value>Exercice</value>
  </data>
  <data name="DD_Exercise_Serving" xml:space="preserve">
    <value>90 min modéré ou 40 min intense</value>
  </data>
  <data name="DD_Exercise_Desc" xml:space="preserve">
    <value>Activité physique quotidienne, que vous pouvez répartir sur la journée</value>
  </data>
  <data name="DD_Exercise_Benefits" xml:space="preserve">
    <value>Essentiel pour la longévité et la santé en général. Il a été démontré que la musculation augmente le taux de NAD+ dans les muscles jusqu'à 127%.</value>
  </data>
  <data name="DD_VitaminB12" xml:space="preserve">
    <value>Vitamine B12</value>
  </data>
  <data name="DD_VitaminB12_Serving" xml:space="preserve">
    <value>Au moins 2000 mcg par semaine ou 50 mcg par jour</value>
  </data>
  <data name="DD_VitaminB12_Desc" xml:space="preserve">
    <value>Un complément de cyanocobalamine, idéalement à croquer, sublingual ou liquide, pris à jeun. Suivi pour votre commodité ; il ne compte pas dans votre total quotidien ni dans votre série.</value>
  </data>
  <data name="DD_VitaminB12_Benefits" xml:space="preserve">
    <value>Essentielle pour le fonctionnement nerveux et la formation des globules rouges. Indispensable dans un régime végétal.</value>
  </data>

  <!-- Twenty-One Tweaks Items -->
