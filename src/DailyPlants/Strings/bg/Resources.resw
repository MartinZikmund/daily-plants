  </data>
  <data name="DD_Cruciferous_ExtraServings_Metric" xml:space="preserve">
    <value>Или 60 г сурови листни, 90 г сварени листни или 20 г кълнове от броколи</value>
  </data>
  <data name="DD_OtherVegetables_ExtraServings_Imperial" xml:space="preserve">
    <value>Или 1 чаша сурови листни зеленчуци, 1/2 чаша зеленчуков сок или 1/4 чаша сушени гъби</value>
  </data>
  <data name="DD_OtherVegetables_ExtraServings_Metric" xml:space="preserve">
    <value>Или 60 г сурови листни зеленчуци, 120 мл зеленчуков сок или 10 г сушени гъби</value>
  </data>
  <data name="DD_WholeGrains_ExtraServings_Imperial" xml:space="preserve">
    <value>Или 1/2 чаша сварени зърнени храни, паста или царевица, 1 чаша студена зърнена закуска, 1 тортила, 1/2 геврек или английска кифла, или 3 чаши пуканки</value>
  </data>
  <data name="DD_WholeGrains_ExtraServings_Metric" xml:space="preserve">
