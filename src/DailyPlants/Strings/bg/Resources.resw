  <!-- Daily Dozen Items -->
  <data name="DD_Beans" xml:space="preserve">
    <value>Бобови</value>
  </data>
  <data name="DD_Beans_Serving_Imperial" xml:space="preserve">
    <value>1/2 чаша сварени или 1/4 чаша хумус</value>
  </data>
  <data name="DD_Beans_Serving_Metric" xml:space="preserve">
    <value>100 г сварени или 70 г хумус</value>
  </data>
  <data name="DD_Beans_Desc" xml:space="preserve">
    <value>Бобови, включително боб, леща, нахут, тофу, темпе и хумус. Фъстъците се броят към ядките, а зеленият боб и граховите шушулки към другите зеленчуци.</value>
  </data>
  <data name="DD_Beans_Benefits" xml:space="preserve">
    <value>Отличен източник на протеини, фибри и сложни въглехидрати. Моделно проучване, основано на данни от Global Burden of Disease, установи, че яденето на повече бобови дава най-големите ползи за продължителността на живота от всички хранителни групи.</value>
  </data>
  <data name="DD_Berries" xml:space="preserve">
    <value>Горски плодове</value>
  </data>
  <data name="DD_Berries_Serving_Imperial" xml:space="preserve">
    <value>1/2 чаша пресни/замразени или 1/4 чаша сушени</value>
  </data>
  <data name="DD_Berries_Serving_Metric" xml:space="preserve">
    <value>70 г пресни/замразени или 40 г сушени</value>
  </data>
  <data name="DD_Berries_Desc" xml:space="preserve">
    <value>Всеки малък ядлив плод, включително череши, грозде, стафиди и кумкуат</value>
  </data>
  <data name="DD_Berries_Benefits" xml:space="preserve">
    <value>Най-високо съдържание на антиоксиданти сред всички плодове. Свързани с по-дълъг живот и когнитивни ползи.</value>
  </data>
  <data name="DD_OtherFruits" xml:space="preserve">
    <value>Други плодове</value>
  </data>
  <data name="DD_OtherFruits_Serving_Imperial" xml:space="preserve">
    <value>1 среден плод или 1/4 чаша сушени</value>
  </data>
  <data name="DD_OtherFruits_Serving_Metric" xml:space="preserve">
    <value>1 среден плод или 40 г сушени</value>
  </data>
  <data name="DD_OtherFruits_Desc" xml:space="preserve">
    <value>Плодове, различни от горски плодове</value>
  </data>
  <data name="DD_OtherFruits_Benefits" xml:space="preserve">
    <value>Богати на витамини, минерали и фибри. Необходими за цялостното здраве.</value>
  </data>
  <data name="DD_Greens" xml:space="preserve">
    <value>Зеленолистни зеленчуци</value>
  </data>
  <data name="DD_Greens_Serving_Imperial" xml:space="preserve">
    <value>1 чаша сурови или 1/2 чаша сварени</value>
  </data>
  <data name="DD_Greens_Serving_Metric" xml:space="preserve">
    <value>60 г сурови или 90 г сварени</value>
  </data>
  <data name="DD_Greens_Desc" xml:space="preserve">
    <value>Тъмнозелени листни зеленчуци</value>
  </data>
  <data name="DD_Greens_Benefits" xml:space="preserve">
    <value>Най-силно свързани с по-дълъг живот сред зеленчуците. Богати на нитрати, които подобряват функцията на мускулите и артериите.</value>
  </data>
  <data name="DD_Cruciferous" xml:space="preserve">
    <value>Кръстоцветни зеленчуци</value>
  </data>
  <data name="DD_Cruciferous_Serving_Imperial" xml:space="preserve">
    <value>1/2 чаша нарязани или 1 с.л. хрян</value>
  </data>
  <data name="DD_Cruciferous_Serving_Metric" xml:space="preserve">
    <value>90 г нарязани или 1 с.л. хрян</value>
  </data>
  <data name="DD_Cruciferous_Desc" xml:space="preserve">
    <value>Броколи, карфиол, зеле, кейл и др.</value>
  </data>
  <data name="DD_Cruciferous_Benefits" xml:space="preserve">
    <value>Съдържа сулфорафан, който подсилва имунната функция и чернодробните детоксикиращи ензими.</value>
  </data>
  <data name="DD_OtherVegetables" xml:space="preserve">
    <value>Други зеленчуци</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Imperial" xml:space="preserve">
    <value>1/2 чаша нелистни зеленчуци</value>
  </data>
  <data name="DD_OtherVegetables_Serving_Metric" xml:space="preserve">
    <value>90 г нелистни зеленчуци</value>
  </data>
  <data name="DD_OtherVegetables_Desc" xml:space="preserve">
    <value>Всички други зеленчуци, включително домати, гъби и зелен боб</value>
  </data>
  <data name="DD_OtherVegetables_Benefits" xml:space="preserve">
    <value>Разнообразни хранителни вещества и фибри. Необходими за балансирано хранене.</value>
  </data>
  <data name="DD_Flaxseed" xml:space="preserve">
    <value>Ленено семе</value>
  </data>
  <data name="DD_Flaxseed_Serving" xml:space="preserve">
    <value>1 с.л. смляно</value>
  </data>
  <data name="DD_Flaxseed_Desc" xml:space="preserve">
    <value>Смляно ленено семе</value>
  </data>
  <data name="DD_Flaxseed_Benefits" xml:space="preserve">
    <value>Най-богат източник на лигнани и омега-3 ALA. Полезно за сърдечното здраве и хормоналния баланс.</value>
  </data>
  <data name="DD_Nuts" xml:space="preserve">
    <value>Ядки и семена</value>
  </data>
  <data name="DD_Nuts_Serving_Imperial" xml:space="preserve">
    <value>1/4 чаша ядки или семена, или 2 с.л. масло от ядки или семена</value>
  </data>
  <data name="DD_Nuts_Serving_Metric" xml:space="preserve">
    <value>30 г ядки или семена, или 2 с.л. масло от ядки или семена</value>
  </data>
  <data name="DD_Nuts_Desc" xml:space="preserve">
    <value>Всички ядки и семена, включително фъстъците. Кестените и кокосите не се броят.</value>
  </data>
  <data name="DD_Nuts_Benefits" xml:space="preserve">
    <value>Проучването Global Burden of Disease постави яденето на твърде малко ядки и семена на трето място сред хранителните рискове за смърт и инвалидност в света.</value>
  </data>
  <data name="DD_Herbs" xml:space="preserve">
