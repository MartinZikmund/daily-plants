<Page
    x:Class="DailyPlants.Views.ResourcesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DailyPlants.Helpers"
    xmlns:local="using:DailyPlants.Views"
    xmlns:vm="using:DailyPlants.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>

        <!--  Thumbnail | kicker over title, summary and date. The whole card is the tap target.  -->
        <DataTemplate x:Key="FeedCardTemplate" x:DataType="vm:FeedItemViewModel">
            <Grid
                MinHeight="84"
                Padding="12"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Background="{ThemeResource DpSurfaceBrush}"
                BorderBrush="{ThemeResource DpHairlineBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="8"
                Tag="{x:Bind}"
                Tapped="FeedCard_Tapped"
                ToolTipService.ToolTip="{helpers:Localize Key=Resources_OpenInBrowser}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Placeholder behind the image: a remote thumbnail may be slow, missing or refused  -->
                <Border
                    Width="112"
                    Height="63"
                    VerticalAlignment="Top"
                    Background="{ThemeResource DpHairlineBrush}"
                    CornerRadius="8">
                    <Image
                        Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind HasThumbnail}" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Style="{StaticResource DpOverlineTextBlockStyle}" Text="{x:Bind KindText}" />
                    <TextBlock
                        Foreground="{ThemeResource DpInkBrush}"
                        MaxLines="2"
                        Style="{StaticResource DpBodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind Summary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasSummary}" />
                    <TextBlock
                        Foreground="{ThemeResource DpGreenInkBrush}"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind PublishedText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title + refresh, the search box, then either the tab strip or the results header, closed by a hairline rule  -->
        <StackPanel Grid.Row="0" Padding="20,20,20,0">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource DpTitleTextBlockStyle}" Text="{helpers:Localize Key=Resources_Title}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{helpers:Localize Key=Resources_Subtitle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ActiveList.UpdatedText, Mode=OneWay}" />
                    <Button
                        Width="28"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ResourcesRefreshButton"
                        AutomationProperties.Name="{helpers:Localize Key=Resources_Refresh}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DpHairlineBrush}"
                        BorderThickness="1"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        CornerRadius="14"
                        ToolTipService.ToolTip="{helpers:Localize Key=Resources_Refresh}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource DpInkBrush}"
                            Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Searches the whole nutritionfacts.org archive, not just the loaded pages  -->
            <AutoSuggestBox
                x:Name="SearchBox"
                MaxWidth="420"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ResourcesSearchBox"
                AutomationProperties.Name="{helpers:Localize Key=Resources_SearchPlaceholder}"
                PlaceholderText="{helpers:Localize Key=Resources_SearchPlaceholder}"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}">

                <!--
                    The stock text-control brushes are Fluent greys and read as a foreign chip on
                    DpGroundBrush. Scoped to this box so nothing else in the app is restyled.
                -->
                <AutoSuggestBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="DpGreenBrush" />
                                <StaticResource x:Key="TextControlForeground" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBorderBrush" ResourceKey="DpHairlineBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="DpGreenBrush" />
                                <StaticResource x:Key="TextControlForeground" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBorderBrush" ResourceKey="DpHairlineBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="TextControlBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderBrush" ResourceKey="DpHairlineBrush" />
                                <StaticResource x:Key="TextControlElevationBorderFocusedBrush" ResourceKey="DpGreenBrush" />
                                <StaticResource x:Key="TextControlForeground" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="DpInkMutedBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="DpInkBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBackground" ResourceKey="DpSurfaceBrush" />
                                <StaticResource x:Key="AutoSuggestBoxSuggestionsListBorderBrush" ResourceKey="DpHairlineBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </AutoSuggestBox.Resources>
            </AutoSuggestBox>

            <!--  Tab strip. Unselected tabs sit back on opacity rather than swapping weight, so selecting one never re-flows the strip.  -->
            <StackPanel
                Margin="0,16,0,0"
                Orientation="Horizontal"
                Spacing="24"
                Visibility="{x:Bind local:ResourcesView.TabsVisibility(ViewModel.IsSearchActive), Mode=OneWay}">
                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0,0,0,8"
                    AutomationProperties.AutomationId="ResourcesTabBlogButton"
                    AutomationProperties.Name="{helpers:Localize Key=Resources_TabBlog}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SelectTabCommand}"
                    CommandParameter="Blog"
                    HorizontalContentAlignment="Stretch"
                    Opacity="{x:Bind local:ResourcesView.TabOpacity(ViewModel.IsBlogSelected), Mode=OneWay}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource DpInkBrush}"
                            Style="{StaticResource DpBodyStrongTextBlockStyle}"
                            Text="{helpers:Localize Key=Resources_TabBlog}" />
                        <Border
                            Grid.Row="1"
                            Height="2"
                            Background="{ThemeResource DpGreenBrush}"
                            CornerRadius="1"
                            Visibility="{x:Bind ViewModel.IsBlogSelected, Mode=OneWay}" />
                    </Grid>
                </Button>

                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0,0,0,8"
                    AutomationProperties.AutomationId="ResourcesTabVideosButton"
                    AutomationProperties.Name="{helpers:Localize Key=Resources_TabVideos}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SelectTabCommand}"
                    CommandParameter="Videos"
                    HorizontalContentAlignment="Stretch"
                    Opacity="{x:Bind local:ResourcesView.TabOpacity(ViewModel.IsVideosSelected), Mode=OneWay}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource DpInkBrush}"
                            Style="{StaticResource DpBodyStrongTextBlockStyle}"
                            Text="{helpers:Localize Key=Resources_TabVideos}" />
                        <Border
                            Grid.Row="1"
                            Height="2"
                            Background="{ThemeResource DpGreenBrush}"
                            CornerRadius="1"
                            Visibility="{x:Bind ViewModel.IsVideosSelected, Mode=OneWay}" />
                    </Grid>
                </Button>

                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0,0,0,8"
                    AutomationProperties.AutomationId="ResourcesTabPodcastButton"
                    AutomationProperties.Name="{helpers:Localize Key=Resources_TabPodcast}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SelectTabCommand}"
                    CommandParameter="Podcast"
                    HorizontalContentAlignment="Stretch"
                    Opacity="{x:Bind local:ResourcesView.TabOpacity(ViewModel.IsPodcastSelected), Mode=OneWay}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource DpInkBrush}"
                            Style="{StaticResource DpBodyStrongTextBlockStyle}"
                            Text="{helpers:Localize Key=Resources_TabPodcast}" />
                        <Border
                            Grid.Row="1"
                            Height="2"
                            Background="{ThemeResource DpGreenBrush}"
                            CornerRadius="1"
                            Visibility="{x:Bind ViewModel.IsPodcastSelected, Mode=OneWay}" />
                    </Grid>
                </Button>
            </StackPanel>

            <!--  Stands in for the tab strip while searching, and is the way back to it  -->
            <Grid
                Margin="0,16,0,16"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.IsSearchActive, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource DpInkBrush}"
                    Style="{StaticResource DpBodyStrongTextBlockStyle}"
                    Text="{x:Bind local:ResourcesView.SearchResultsHeader(ViewModel.SearchResults.Query), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <HyperlinkButton
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ResourcesClearSearchButton"
                    AutomationProperties.Name="{helpers:Localize Key=Resources_SearchClear}"
                    Command="{x:Bind ViewModel.ClearSearchCommand}"
                    Content="{helpers:Localize Key=Resources_SearchClear}" />
            </Grid>

            <Border Height="1" Background="{ThemeResource DpHairlineBrush}" />
        </StackPanel>

        <ScrollViewer
            x:Name="FeedScrollViewer"
            Grid.Row="1"
            Padding="20,16,20,20"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="FeedScrollViewer_ViewChanged">
            <StackPanel Spacing="12">

                <!--  Cached posts are still worth reading, so the notice sits above them rather than replacing them  -->
                <Border
                    Padding="12"
                    Background="{ThemeResource DpSurfaceBrush}"
                    BorderBrush="{ThemeResource DpHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.ActiveList.ShowNotice, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Top"
                            FontSize="14"
                            Foreground="{ThemeResource DpClayBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            Style="{StaticResource DpCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ActiveList.NoticeText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemTemplate="{StaticResource FeedCardTemplate}" ItemsSource="{x:Bind ViewModel.ActiveList.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!--  Sits under the last card, so reaching it is the same gesture that asks for the next page  -->
                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ActiveList.ShowLoadingMore, Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        Foreground="{ThemeResource DpGreenBrush}"
                        IsActive="{x:Bind ViewModel.ActiveList.ShowLoadingMore, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{helpers:Localize Key=Resources_LoadingMore}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="1"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource DpGreenBrush}"
            IsActive="{x:Bind ViewModel.ActiveList.IsLoading, Mode=OneWay}" />

        <StackPanel
            Grid.Row="1"
            MaxWidth="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4"
            Visibility="{x:Bind ViewModel.ActiveList.ShowEmptyState, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource DpInkMutedBrush}"
                Glyph="&#xE8F1;" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource DpInkBrush}"
                Style="{StaticResource DpSubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.ActiveList.EmptyStateText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!--  Two details, one headline: browsing sends you to refresh, searching sends you to a different word  -->
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource DpInkMutedBrush}"
                Style="{StaticResource DpBodyTextBlockStyle}"
                Text="{helpers:Localize Key=Resources_EmptyDetail}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:ResourcesView.TabsVisibility(ViewModel.IsSearchActive), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource DpInkMutedBrush}"
                Style="{StaticResource DpBodyTextBlockStyle}"
                Text="{helpers:Localize Key=Resources_SearchEmptyDetail}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsSearchActive, Mode=OneWay}" />

            <HyperlinkButton
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ResourcesRetryButton"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="{helpers:Localize Key=Resources_Retry}" />
        </StackPanel>
    </Grid>
</Page>
