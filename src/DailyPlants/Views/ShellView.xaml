<Page x:Class="DailyPlants.Views.ShellView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DailyPlants.Views"
      xmlns:controls="using:DailyPlants.Controls"
      xmlns:helpers="using:DailyPlants.Helpers"
      xmlns:toolkit="using:Uno.UI.Toolkit"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      Background="{ThemeResource DpGroundBrush}">

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">

        <!--
            The system draws the caption buttons, so their colours have to be handed to
            AppWindowTitleBar as Color values rather than brushes. This zero-size probe
            is how code reads the theme-resolved palette without hardcoding hex.
        -->
        <Border
            x:Name="ThemeProbe"
            Width="0"
            Height="0"
            Background="{ThemeResource DpInkBrush}"
            BorderBrush="{ThemeResource DpInkMutedBrush}"
            IsHitTestVisible="False" />
        <NavigationView x:Name="NavView"
                        AutomationProperties.AutomationId="ShellNavigationView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="500"
                        SelectionChanged="NavView_SelectionChanged">

            <!--
                The pane keeps DpSurfaceBrush so it reads as its own surface. The content
                area is deliberately transparent: on Windows the Mica backdrop shows
                through it, and on every other head it falls through to this page's
                DpGroundBrush. Painting it opaque is what left a 1px seam of raw Mica
                against the pane edge.
            -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DpGroundScrimBrush" />
                            <StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="DpHairlineBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DpGroundScrimBrush" />
                            <StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="DpHairlineBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DpSurfaceBrush" />
                            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DpGroundScrimBrush" />
                            <StaticResource x:Key="NavigationViewItemSeparatorForeground" ResourceKey="DpHairlineBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{helpers:Localize Key=Nav_Diary}" Tag="Diary" AutomationProperties.AutomationId="NavItemDiary">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M 12.5 4 C 10.032499 4 8 6.0324991 8 8.5 L 8 37.253906 A 1.50015 1.50015 0 0 0 8 37.740234 L 8 39.5 C 8 41.967501 10.032499 44 12.5 44 L 38.5 44 A 1.50015 1.50015 0 1 0 38.5 41 L 12.5 41 C 11.653501 41 11 40.346499 11 39.5 L 11 39 L 38.5 39 A 1.50015 1.50015 0 0 0 40 37.5 L 40 8.5 C 40 6.0324991 37.967501 4 35.5 4 L 12.5 4 z M 12.5 7 L 35.5 7 C 36.346499 7 37 7.6535009 37 8.5 L 37 36 L 11 36 L 11 8.5 C 11 7.6535009 11.653501 7 12.5 7 z M 17.5 14 A 1.50015 1.50015 0 1 0 17.5 17 L 30.5 17 A 1.50015 1.50015 0 1 0 30.5 14 L 17.5 14 z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Localize Key=Nav_Latest}" Tag="Latest" AutomationProperties.AutomationId="NavItemLatest">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Localize Key=Nav_Statistics}" Tag="Statistics" AutomationProperties.AutomationId="NavItemStatistics">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M 37.994141 4 C 35.247707 4 32.990234 6.2594255 32.990234 9.0058594 L 32.990234 39 C 32.990234 41.746434 35.247707 44.005859 37.994141 44.005859 C 40.740575 44.005859 43 41.746434 43 39 L 43 9.0058594 C 43 6.2594255 40.740575 4 37.994141 4 z M 37.994141 7 C 39.119707 7 40 7.8802933 40 9.0058594 L 40 39 C 40 40.125566 39.119707 41.005859 37.994141 41.005859 C 36.868575 41.005859 35.990234 40.125566 35.990234 39 L 35.990234 9.0058594 C 35.990234 7.8802933 36.868575 7 37.994141 7 z M 9.9941406 13.005859 C 7.2477067 13.005859 4.9902344 15.263332 4.9902344 18.009766 L 4.9902344 39 C 4.9902344 41.746434 7.2477067 44.005859 9.9941406 44.005859 C 12.740575 44.005859 15 41.746434 15 39 L 15 18.009766 C 15 15.263332 12.740575 13.005859 9.9941406 13.005859 z M 9.9941406 16.005859 C 11.119707 16.005859 12 16.8842 12 18.009766 L 12 39 C 12 40.125566 11.119707 41.005859 9.9941406 41.005859 C 8.8685745 41.005859 7.9902344 40.125566 7.9902344 39 L 7.9902344 18.009766 C 7.9902344 16.8842 8.8685745 16.005859 9.9941406 16.005859 z M 24 22 C 21.253566 22 18.994141 24.259425 18.994141 27.005859 L 18.994141 39 C 18.994141 41.746434 21.253566 44.005859 24 44.005859 C 26.746434 44.005859 29.005859 41.746434 29.005859 39 L 29.005859 27.005859 C 29.005859 24.259425 26.746434 22 24 22 z M 24 25 C 25.125566 25 26.005859 25.880293 26.005859 27.005859 L 26.005859 39 C 26.005859 40.125566 25.125566 41.005859 24 41.005859 C 22.874434 41.005859 21.994141 40.125566 21.994141 39 L 21.994141 27.005859 C 21.994141 25.880293 22.874434 25 24 25 z" />
