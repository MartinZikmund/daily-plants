                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="{helpers:Localize Key=Nav_About}" Tag="About" AutomationProperties.AutomationId="NavItemAbout">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M 24 4 C 12.972066 4 4 12.972074 4 24 C 4 35.027926 12.972066 44 24 44 C 35.027934 44 44 35.027926 44 24 C 44 12.972074 35.027934 4 24 4 z M 24 7 C 33.406615 7 41 14.593391 41 24 C 41 33.406609 33.406615 41 24 41 C 14.593385 41 7 33.406609 7 24 C 7 14.593391 14.593385 7 24 7 z M 24 14 A 2 2 0 0 0 24 18 A 2 2 0 0 0 24 14 z M 23.976562 20.978516 A 1.50015 1.50015 0 0 0 22.5 22.5 L 22.5 33.5 A 1.50015 1.50015 0 1 0 25.5 33.5 L 25.5 22.5 A 1.50015 1.50015 0 0 0 23.976562 20.978516 z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="Transparent">
                <Frame x:Name="ContentFrame" MaxWidth="1400" />

                <Grid
                    Height="46"
                    x:Name="TitleBarOuter"
                    Padding="0,0"
                    Background="{ThemeResource DpSurfaceBrush}"
                    VerticalAlignment="Top"
                    ColumnSpacing="16"
                    Visibility="{x:Bind HasCustomTitleBar}">

                    <Grid Margin="0,0,0,0" x:Name="DraggableTitleBar">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Image Source="ms-appx:///Assets/Svg/applogo.svg" Width="16" />
                            <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DpCaptionTextBlockStyle}"
                            Text="Daily Plants" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </NavigationView>

        <!-- Achievement Notification Popup -->
        <controls:AchievementNotification x:Name="AchievementNotification" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleBarOuter.Padding" Value="48,0,0,0" />
                        <Setter Target="ContentFrame.Margin" Value="0,48,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleBarOuter.Padding" Value="0,0,0,0" />
                        <Setter Target="ContentFrame.Margin" Value="56,44,56,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</Page>
