<Page x:Class="DailyPlants.Views.StatisticsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:DailyPlants.Controls"
      xmlns:converters="using:DailyPlants.Converters"
      xmlns:vm="using:DailyPlants.ViewModels"
      xmlns:helpers="using:DailyPlants.Helpers"
      NavigationCacheMode="Required">

    <Page.Resources>
        <!--  Reused for the daily-completion columns: Border.Height = Share * MaxHeight  -->
        <converters:ProgressToHeightConverter x:Key="DailyBarHeightConverter" MaxHeight="96" />
    </Page.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{helpers:Localize Key=Nav_Statistics}"
                   Style="{StaticResource DpTitleTextBlockStyle}"
                   Padding="20,20,20,0" />

        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" Padding="20,0,20,20">
            <StackPanel Spacing="32">

                <!--  Empty state: nothing enabled to track  -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,32"
                            Visibility="{x:Bind Not(ViewModel.HasAnyData), Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="48" Opacity="0.5" />
                    <TextBlock Text="{helpers:Localize Key=Stats_NoWeightData}"
                               Style="{StaticResource DpSubtitleTextBlockStyle}"
                               Margin="0,12,0,4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{helpers:Localize Key=Stats_AddFirstWeight}"
                               Style="{StaticResource DpCaptionTextBlockStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--  ================= Panel 1: Daily completion ================= -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasChecklistData, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Daily completion" Style="{StaticResource DpSubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Last 30 days" Style="{StaticResource DpCaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid AutomationProperties.Name="{x:Bind ViewModel.DailyCompletionAutomationName, Mode=OneWay}">
                        <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource DpHairlineBrush}" />
                        <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource DpHairlineBrush}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyCompletion, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal"
                                                    MinItemWidth="4"
                                                    MinItemHeight="4"
                                                    MinColumnSpacing="4"
                                                    MaximumRowsOrColumns="30"
                                                    ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DailyCompletionPoint">
                                    <Grid Height="96">
                                        <Border VerticalAlignment="Bottom"
                                                CornerRadius="3,3,0,0"
                                                Background="{ThemeResource DpGreenBrush}"
                                                Height="{x:Bind Share, Converter={StaticResource DailyBarHeightConverter}, Mode=OneTime}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource DpCaptionTextBlockStyle}" Text="{x:Bind ViewModel.DailyFirstDateLabel, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource DpCaptionTextBlockStyle}" Text="{x:Bind ViewModel.DailyMiddleDateLabel, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" MinWidth="88" Style="{StaticResource DpCaptionTextBlockStyle}" Text="{x:Bind ViewModel.DailyTodayLabel, Mode=OneWay}" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DpHairlineBrush}" />
                </StackPanel>

                <!--  ================= Panel 2: Streaks ================= -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasChecklistData, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Localize Key=Stats_Streaks}" Style="{StaticResource DpSubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Consecutive days at 100%" Style="{StaticResource DpCaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource DpGreenBrush}" />
                                <TextBlock Text="{helpers:Localize Key=Stats_CurrentStreak}" Style="{StaticResource DpOverlineTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CurrentStreakText, Mode=OneWay}"
                                       Style="{StaticResource DpSubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource DpGreenInkBrush}"
                                       MinWidth="72" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentStreakCaption, Mode=OneWay}" Style="{StaticResource DpCaptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{ThemeResource DpGreenBrush}" />
                                <TextBlock Text="{helpers:Localize Key=Stats_LongestStreak}" Style="{StaticResource DpOverlineTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LongestStreakText, Mode=OneWay}"
                                       Style="{StaticResource DpSubtitleTextBlockStyle}"
                                       Foreground="{ThemeResource DpGreenInkBrush}"
                                       MinWidth="72" />
                            <TextBlock Text="{x:Bind ViewModel.LongestStreakCaption, Mode=OneWay}" Style="{StaticResource DpCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DpHairlineBrush}" />
                </StackPanel>

                <!--  ================= Panel 3: What you miss most ================= -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasChecklistData, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="What you miss most" Style="{StaticResource DpSubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Last 30 days" Style="{StaticResource DpCaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.MissedItems, Mode=OneWay}"
                                   AutomationProperties.Name="What you miss most, worst first, last 30 days">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemMissViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DpBodyTextBlockStyle}"
                                               Text="{x:Bind ItemName}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Border Height="7" CornerRadius="3" Background="{ThemeResource DpHairlineBrush}" />
                                        <Border Height="7"
                                                CornerRadius="3"
                                                HorizontalAlignment="Stretch"
                                                RenderTransformOrigin="0,0"
                                                Background="{ThemeResource DpGreenBrush}"
                                                Visibility="{x:Bind NormalVisibility}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{x:Bind CompletionRate}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Height="7"
                                                CornerRadius="3"
                                                HorizontalAlignment="Stretch"
                                                RenderTransformOrigin="0,0"
                                                Background="{ThemeResource DpClayBrush}"
                                                Visibility="{x:Bind BelowHalfVisibility}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{x:Bind CompletionRate}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               MinWidth="40"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DpCaptionTextBlockStyle}"
                                               Text="{x:Bind CompletionText}"
                                               Visibility="{x:Bind NormalVisibility}" />
                                    <TextBlock Grid.Column="2"
                                               MinWidth="40"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DpCaptionTextBlockStyle}"
                                               Foreground="{ThemeResource DpClayBrush}"
                                               Text="{x:Bind CompletionText}"
                                               Visibility="{x:Bind BelowHalfVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border Height="1" Background="{ThemeResource DpHairlineBrush}" />
                </StackPanel>

                <!--  ================= Panel 4: Weight ================= -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.WeightTrackingEnabled, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{helpers:Localize Key=Stats_WeightTrend}" Style="{StaticResource DpSubtitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="Last 30 days" Style="{StaticResource DpCaptionTextBlockStyle}" VerticalAlignment="Bottom" />
                    </Grid>

                    <controls:ChartWeightLine Height="180"
                                               HorizontalAlignment="Stretch"
                                               Points="{x:Bind ViewModel.WeightHistory, Mode=OneWay}"
                                               GoalWeight="{x:Bind ViewModel.GoalWeightForChart, Mode=OneWay}"
                                               WeightUnit="{x:Bind ViewModel.WeightUnit, Mode=OneWay}"
                                               LineBrush="{ThemeResource DpGreenBrush}"
                                               GridlineBrush="{ThemeResource DpHairlineBrush}"
                                               MutedTextBrush="{ThemeResource DpInkMutedBrush}"
                                               EmphasisTextBrush="{ThemeResource DpInkBrush}"
                                               GoalBrush="{ThemeResource DpClayBrush}"
                                               Visibility="{x:Bind VisibleIfAny(ViewModel.WeightHistory.Count), Mode=OneWay}"
                                               AutomationProperties.Name="{x:Bind ViewModel.WeightChartAutomationName, Mode=OneWay}" />

                    <TextBlock Text="No weight entries yet."
                               Style="{StaticResource DpCaptionTextBlockStyle}"
                               Visibility="{x:Bind VisibleIfZero(ViewModel.WeightHistory.Count), Mode=OneWay}" />

                    <Grid ColumnSpacing="8" Visibility="{x:Bind VisibleIfAny(ViewModel.WeightHistory.Count), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource DpCaptionTextBlockStyle}" Text="{x:Bind ViewModel.WeightFirstDateLabel, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource DpCaptionTextBlockStyle}" Text="{x:Bind ViewModel.WeightLastDateWithChangeLabel, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                  Text="{Binding WeightInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  InputScope="Number"
                                  AutomationProperties.AutomationId="WeightInputTextBox" />
                        <Button Grid.Column="1"
                                Content="{helpers:Localize Key=Common_Save}"
                                Command="{x:Bind ViewModel.SaveTodayWeightCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SaveWeightButton" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DpHairlineBrush}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
