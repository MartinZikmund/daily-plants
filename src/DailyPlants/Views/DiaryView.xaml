<Page
    x:Class="DailyPlants.Views.DiaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DailyPlants.Controls"
    xmlns:helpers="using:DailyPlants.Helpers"
    xmlns:vm="using:DailyPlants.ViewModels">

    <Page.Resources>

        <!--  One row per item: 28px icon | name over serving size | dots + add  -->
        <DataTemplate x:Key="ServingRowTemplate" x:DataType="vm:ChecklistItemViewModel">
            <!--
                Tag carries the item: ItemsRepeater does not set DataContext on templates
                that use x:Bind, so the tap handler had nothing to read and silently did
                nothing.
            -->
            <Grid
                MinHeight="56"
                Padding="2,12"
                Background="Transparent"
                BorderBrush="{ThemeResource DpHairlineBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="12"
                Tag="{x:Bind}"
                Tapped="ItemRow_Tapped">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Right-click / long-press keeps decrement and details reachable off the row  -->
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{x:Bind IncrementServingCommand}" Text="{helpers:Localize Key=Diary_IncreaseServing}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Command="{x:Bind DecrementServingCommand}" Text="{helpers:Localize Key=Diary_DecreaseServing}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE738;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{x:Bind ShowItemDetailCommand}" Text="{helpers:Localize Key=Diary_MoreInfo}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <BitmapIcon
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    ShowAsMonochrome="False"
                    UriSource="{x:Bind Item.IconPath, Converter={StaticResource StringToUriConverter}}" />

                <!--  Transparent, so the empty space beside the text is still a hit target for the row  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <TextBlock
                        Foreground="{ThemeResource DpInkBrush}"
                        Style="{StaticResource DpBodyStrongTextBlockStyle}"
                        Text="{x:Bind Item.Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind ServingSizeDisplay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <controls:ServingStepper
                    x:Name="ServingControls"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Item="{x:Bind}" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates" CurrentStateChanged="WidthStates_CurrentStateChanged">
                <VisualState x:Name="SingleColumnState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="TwoColumnState">
                    <VisualState.StateTriggers>
                        <!--
                            Window width, not content width: the nav pane (~320) plus frame
                            margins (112) and canvas padding (40) leave far less than the
                            2 x 380 + 24 the two-column layout needs.
                        -->
                        <AdaptiveTrigger MinWindowWidth="1300" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Header: page label, the date, the day steppers  -->
        <Grid Margin="20,20,20,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource DpOverlineTextBlockStyle}" Text="{helpers:Localize Key=Nav_Diary}" />

                <Button
                    x:Name="DatePickerButton"
                    Margin="0,4,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="DiaryDatePickerButton"
                    AutomationProperties.Name="{helpers:Localize Key=Diary_PickDate}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{helpers:Localize Key=Diary_PickDate}">
                    <TextBlock
                        Foreground="{ThemeResource DpInkBrush}"
                        Style="{StaticResource DpTitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.DateDisplayText, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="DatePickerFlyout" Placement="Bottom">
                            <CalendarView
                                x:Name="CalendarView"
                                MaxDate="{x:Bind ViewModel.MaxSelectableDate, Mode=OneWay}"
                                SelectedDatesChanged="CalendarView_SelectedDatesChanged"
                                SelectionMode="Single" />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DayContextText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowDayContext, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DiaryGoToTodayButton"
                        Command="{x:Bind ViewModel.GoToTodayCommand}"
                        Content="{helpers:Localize Key=Diary_GoToToday}"
                        Visibility="{x:Bind ViewModel.ShowGoToToday, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Width="28"
                    Height="28"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    AutomationProperties.AutomationId="DiaryPreviousDayButton"
                    AutomationProperties.Name="{helpers:Localize Key=Diary_PreviousDay}"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DpHairlineBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.GoToPreviousDayCommand}"
                    CornerRadius="14"
                    ToolTipService.ToolTip="{helpers:Localize Key=Diary_PreviousDay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource DpInkBrush}"
                        Glyph="&#xE76B;" />
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    AutomationProperties.AutomationId="DiaryNextDayButton"
                    AutomationProperties.Name="{helpers:Localize Key=Diary_NextDay}"
                    Background="Transparent"
                    BorderBrush="{ThemeResource DpHairlineBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.GoToNextDayCommand}"
                    CornerRadius="14"
                    IsEnabled="{x:Bind ViewModel.CanGoToNextDay, Mode=OneWay}"
                    ToolTipService.ToolTip="{helpers:Localize Key=Diary_NextDay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource DpInkBrush}"
                        Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Tally: the count over a 3px track, closed by a hairline rule  -->
        <Grid
            Grid.Row="1"
            Margin="20,16,20,0"
            Padding="0,0,0,12"
            BorderBrush="{ThemeResource DpHairlineBrush}"
            BorderThickness="0,0,0,1"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.ShowTally, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                MinWidth="120"
                HorizontalAlignment="Left"
                Style="{StaticResource DpTallyTextBlockStyle}"
                Text="{x:Bind ViewModel.ServingsTallyText, Mode=OneWay}" />

            <Border
                x:Name="TallyTrack"
                Grid.Row="1"
                Height="3"
                Background="{ThemeResource DpHairlineBrush}"
                SizeChanged="TallyTrack_SizeChanged">
                <Rectangle
                    x:Name="TallyFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource DpGreenBrush}" />
            </Border>
        </Grid>

        <ScrollViewer
            Grid.Row="2"
            Padding="20,0,20,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Collapsed until the day is complete, so it carries no margin of its own  -->
                <controls:DayCompleteParade x:Name="Parade" />

                <!--  Still to go  -->
                <Grid
                    Margin="0,16,0,8"
                    ColumnSpacing="12"
                    Visibility="{x:Bind ViewModel.ShowStillToGoGroup, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DpOverlineTextBlockStyle}"
                        Text="{x:Bind ViewModel.StillToGoHeaderText}" />
                    <Rectangle
                        Grid.Column="1"
                        Height="1"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DpHairlineBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource DpGreenInkBrush}"
                        Style="{StaticResource DpCaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StillToGoCountText, Mode=OneWay}" />
                </Grid>

                <ItemsRepeater
                    x:Name="StillToGoRepeater"
                    ElementPrepared="GroupRepeater_ElementPrepared"
                    ItemTemplate="{StaticResource ServingRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.StillToGo}"
                    Visibility="{x:Bind ViewModel.ShowStillToGoGroup, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="StillToGoLayout"
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="1"
                            MinColumnSpacing="24"
                            MinItemWidth="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!--  Done today, collapsible  -->
                <Button
                    Margin="0,16,0,8"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="DiaryDoneTodayToggle"
                    AutomationProperties.Name="{x:Bind ViewModel.DoneTodayHeaderText}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleDoneTodayCommand}"
                    Visibility="{x:Bind ViewModel.ShowDoneTodayGroup, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DpOverlineTextBlockStyle}"
                            Text="{x:Bind ViewModel.DoneTodayHeaderText}" />
                        <Rectangle
                            Grid.Column="1"
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DpHairlineBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource DpGreenInkBrush}"
                            Style="{StaticResource DpCaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.DoneTodayCountText, Mode=OneWay}" />
                        <FontIcon
                            Grid.Column="3"
                            FontSize="12"
                            Foreground="{ThemeResource DpInkMutedBrush}"
                            Glyph="{x:Bind ChevronGlyph(ViewModel.IsDoneTodayExpanded), Mode=OneWay}" />
                    </Grid>
                </Button>

                <ItemsRepeater
                    x:Name="DoneTodayRepeater"
                    ElementPrepared="GroupRepeater_ElementPrepared"
                    ItemTemplate="{StaticResource ServingRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.DoneToday}"
                    Opacity="0.48"
                    Visibility="{x:Bind ViewModel.ShowDoneTodayRows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="DoneTodayLayout"
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="1"
                            MinColumnSpacing="24"
                            MinItemWidth="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="2"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource DpGreenBrush}"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource DpInkMutedBrush}"
                Glyph="&#xE71E;" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource DpInkBrush}"
                Style="{StaticResource DpSubtitleTextBlockStyle}"
                Text="{helpers:Localize Key=Diary_NoChecklists}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource DpInkMutedBrush}"
                Style="{StaticResource DpBodyTextBlockStyle}"
                Text="{helpers:Localize Key=Diary_EnableChecklist}" />
        </StackPanel>
    </Grid>

</Page>
