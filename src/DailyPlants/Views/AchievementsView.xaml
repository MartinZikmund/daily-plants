<Page x:Class="DailyPlants.Views.AchievementsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:DailyPlants.Converters"
      xmlns:vm="using:DailyPlants.ViewModels"
      NavigationCacheMode="Required"
      xmlns:helpers="using:DailyPlants.Helpers">

    <Page.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title + tally  -->
        <StackPanel Grid.Row="0" Padding="20,20,20,0">
            <TextBlock Text="{helpers:Localize Key=Nav_Achievements}"
                       Style="{StaticResource DpTitleTextBlockStyle}" />

            <Grid Margin="0,16,0,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           MinWidth="96"
                           Text="{x:Bind ViewModel.TallyText, Mode=OneWay}"
                           Style="{StaticResource DpTallyTextBlockStyle}" />

                <ProgressBar Grid.Row="1"
                             Height="3"
                             CornerRadius="0"
                             Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                             Value="{x:Bind ViewModel.EarnedCount, Mode=OneWay}"
                             Foreground="{ThemeResource DpGreenBrush}"
                             Background="{ThemeResource DpHairlineBrush}" />
            </Grid>

            <Border Height="1"
                    Margin="0,16,0,0"
                    Background="{ThemeResource DpHairlineBrush}" />
        </StackPanel>

        <!--  Achievement wall  -->
        <ScrollViewer Grid.Row="1" Padding="20,16,20,20">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AchievementGroups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementGroupViewModel">
                        <StackPanel>
                            <!--  Group header  -->
                            <Grid Margin="0,16,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind TypeName}"
                                           Style="{StaticResource DpOverlineTextBlockStyle}" />
                                <Border Grid.Column="1"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource DpHairlineBrush}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind TallyText}"
                                           Style="{StaticResource DpCaptionTextBlockStyle}"
                                           Foreground="{ThemeResource DpGreenInkBrush}" />
                            </Grid>

                            <!--  Tiles  -->
                            <ItemsRepeater ItemsSource="{x:Bind Achievements}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="200"
                                                        MinRowSpacing="16"
                                                        MinColumnSpacing="16"
                                                        ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AchievementViewModel">
                                        <Grid AutomationProperties.Name="{x:Bind AutomationName}"
                                              AutomationProperties.HelpText="{x:Bind Description}"
                                              AutomationProperties.AutomationId="{x:Bind Achievement.Id}"
                                              ToolTipService.ToolTip="{x:Bind Description}">

                                            <!--  Earned chrome  -->
                                            <Border Background="{ThemeResource DpSurfaceBrush}"
                                                    BorderBrush="{ThemeResource DpHairlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{x:Bind IsEarned}" />

                                            <!--  Locked chrome: transparent, dashed hairline  -->
                                            <Rectangle Fill="Transparent"
                                                       Stroke="{ThemeResource DpHairlineBrush}"
                                                       StrokeThickness="1"
                                                       StrokeDashArray="4,3"
                                                       RadiusX="8"
                                                       RadiusY="8"
                                                       Visibility="{x:Bind IsLocked}" />

                                            <StackPanel Padding="16"
                                                        Spacing="8"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">

                                                <Border Width="64" Height="64"
                                                        CornerRadius="32"
                                                        HorizontalAlignment="Center"
                                                        Opacity="{x:Bind BadgeOpacity}"
                                                        Background="{x:Bind BadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                    <BitmapIcon UriSource="{x:Bind IconUri}"
                                                                ShowAsMonochrome="{x:Bind ShowAsMonochrome}"
                                                                Width="38" Height="38"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                </Border>

                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource DpBodyStrongTextBlockStyle}"
                                                           Foreground="{ThemeResource DpInkBrush}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Stretch"
                                                           Visibility="{x:Bind IsEarned}" />
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource DpBodyStrongTextBlockStyle}"
                                                           Foreground="{ThemeResource DpInkMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Stretch"
                                                           Visibility="{x:Bind IsLocked}" />

                                                <TextBlock Text="{x:Bind EarnedDateText}"
                                                           Style="{StaticResource DpCaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource DpGreenInkBrush}"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind IsEarned}" />

                                                <StackPanel Spacing="4" Visibility="{x:Bind IsLocked}">
                                                    <TextBlock Text="{x:Bind ProgressText}"
                                                               Style="{StaticResource DpCaptionTextBlockStyle}"
                                                               HorizontalAlignment="Center" />
                                                    <ProgressBar Height="4"
                                                                 CornerRadius="0"
                                                                 Maximum="1"
                                                                 Value="{x:Bind Progress}"
                                                                 Foreground="{ThemeResource DpGreenBrush}"
                                                                 Background="{ThemeResource DpHairlineBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  Loading Indicator  -->
        <ProgressRing Grid.Row="1"
                      Width="48" Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!--  Empty State  -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.AchievementGroups.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibleConverter}}">
            <FontIcon Glyph="&#xE735;" FontSize="48" Foreground="{ThemeResource DpInkMutedBrush}" />
            <TextBlock Text="{helpers:Localize Key=Achievements_Empty}"
                       Style="{StaticResource DpSubtitleTextBlockStyle}"
                       Foreground="{ThemeResource DpInkMutedBrush}"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Grid>

</Page>
