<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Fraunces carries four display sizes; Karla carries everything else.
        If the embedded files are missing at runtime the platform falls back on
        its own default rather than failing, so the app still renders.
    -->
    <FontFamily x:Key="DpDisplayFont">ms-appx:///Assets/Fonts/Fraunces.ttf#Fraunces</FontFamily>
    <FontFamily x:Key="DpBodyFont">ms-appx:///Assets/Fonts/Karla.ttf#Karla</FontFamily>

    <!--  Makes Karla the default for stock controls, so views don't each have to opt in  -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Karla.ttf#Karla</FontFamily>

    <!--  Display: the parade headline, and nothing else  -->
    <Style x:Key="DpDisplayTextBlockStyle"
           BasedOn="{StaticResource TitleLargeTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpDisplayFont}" />
    </Style>

    <!--  Title: page titles and the date  -->
    <Style x:Key="DpTitleTextBlockStyle"
           BasedOn="{StaticResource TitleTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpDisplayFont}" />
    </Style>

    <!--  Subtitle: the tally, panel headings, stat values  -->
    <Style x:Key="DpSubtitleTextBlockStyle"
           BasedOn="{StaticResource SubtitleTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpDisplayFont}" />
    </Style>

    <!--  Item names  -->
    <Style x:Key="DpBodyStrongTextBlockStyle"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpBodyFont}" />
    </Style>

    <Style x:Key="DpBodyTextBlockStyle"
           BasedOn="{StaticResource BodyTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpBodyFont}" />
    </Style>

    <!--  Serving sizes, axis labels, timestamps  -->
    <Style x:Key="DpCaptionTextBlockStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpBodyFont}" />
        <Setter Property="Foreground" Value="{ThemeResource DpInkMutedBrush}" />
    </Style>

    <!--  Group headers: "Still to go", "Done today"  -->
    <Style x:Key="DpOverlineTextBlockStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpBodyFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource DpInkMutedBrush}" />
    </Style>

    <!--
        The tally counts up during the parade. WinUI has no tabular-figures
        setter, so give it a MinWidth at the usage site instead of letting the
        glyph widths shuffle the layout.
    -->
    <Style x:Key="DpTallyTextBlockStyle"
           BasedOn="{StaticResource DpSubtitleTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource DpGreenInkBrush}" />
    </Style>

</ResourceDictionary>
