<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.26100;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>Daily Plants</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>dev.mzikmund.dailyplants</ApplicationId>
        <!-- Package Publisher -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <!-- Package Description -->
        <Description>Daily Plants powered by Uno Platform.</Description>
        
        <UnoFeatures>
            Hosting;
            Logging;
            LoggingSerilog;
            Mvvm;
            SkiaRenderer;
            Toolkit;
        </UnoFeatures>
        <!--
          WinUI renders SVG itself; on Windows the Svg feature only adds SkiaSharp views and ANGLE (~5 MB).
          https://github.com/unoplatform/uno/issues/24576
        -->
        <UnoFeatures Condition="'$(IsWinAppSdk)' != 'true'">$(UnoFeatures);Svg</UnoFeatures>

        <UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
        <UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

        <UnoIconForegroundScale>1</UnoIconForegroundScale>
        <UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.6</UnoIconForegroundScale>

        <UnoSplashScreenScale>0.85</UnoSplashScreenScale>

        <!--
          App Store Connect rejects a MinimumOSVersion below 15.0 from Spring 2027 (ITMS-90068).
          The Uno SDK still defaults this to 14.2, and the value ends up in the generated Info.plist.
        -->
        <SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <!--
          Uno.Sdk bundles the whole Windows App SDK (~60 MB) into MSIX packages. Depend on the framework
          package instead, which the Store installs, like a plain WinUI app does.
          https://github.com/unoplatform/uno/issues/24578
        -->
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <!-- Full trimming breaks the Localize markup extension at startup; partial only trims the framework. -->
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <ItemGroup>
        <!-- The test project drives a few internal test seams (the search debounce, for one). -->
        <InternalsVisibleTo Include="DailyPlants.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    </ItemGroup>

    <ItemGroup>
      <UnoImage Update="Assets\AppLogo.svg" Link="Assets\Svg\applogo.svg" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="Assets\Svg\applogo.svg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- Tile/splash images referenced by Package.appxmanifest; Uno's default png glob skips the WinAppSDK head -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
      <Content Include="Platforms\Windows\**\*.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
