<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.26100;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>Daily Plants</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>dev.mzikmund.dailyplants</ApplicationId>
        <!-- Package Publisher -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <!-- Package Description -->
        <Description>Daily Plants powered by Uno Platform.</Description>
        
        <UnoFeatures>
            Hosting;
            Logging;
            LoggingSerilog;
            Mvvm;
            SkiaRenderer;
            Toolkit;
        </UnoFeatures>
        <!--
          WinUI renders SVG itself; on Windows the Svg feature only adds SkiaSharp views and ANGLE (~5 MB).
          https://github.com/unoplatform/uno/issues/24576
        -->
        <UnoFeatures Condition="'$(IsWinAppSdk)' != 'true'">$(UnoFeatures);Svg</UnoFeatures>

        <UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
        <!-- The App Store rejects a transparent icon (ITMS-90717), so iOS needs the opaque plate -->
        <UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

        <UnoIconForegroundScale>1</UnoIconForegroundScale>
        <UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.6</UnoIconForegroundScale>
        <!-- Leaves a clear green margin, so the backplate reads as intended rather than a thin rim -->
        <UnoIconForegroundScale Condition="'$(IsIOS)' == 'true'">0.8</UnoIconForegroundScale>

        <UnoSplashScreenScale>0.85</UnoSplashScreenScale>

        <!--
          App Store Connect rejects a MinimumOSVersion below 15.0 from Spring 2027 (ITMS-90068).
          The Uno SDK still defaults this to 14.2, and the value ends up in the generated Info.plist.
        -->
        <SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>

        <!--
          Google Play automatic protection requires minSdk 24.
          The Uno SDK defaults net10.0-android to 21; 7.0 raises it to 24.
        -->
        <SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <!-- Full trimming strips what XAML reaches through WinRT: the Localize extension, converters and {Binding} sources. -->
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <!-- The macOS app bundle, see docs/store/macos -->
    <PropertyGroup Condition="'$(IsDesktop)' == 'true'">
        <UnoMacOSCustomInfoPlist>$(MSBuildThisFileDirectory)Platforms/Desktop/macOS/Info.plist</UnoMacOSCustomInfoPlist>
        <UnoMacOSMinimumSystemVersion>12.0</UnoMacOSMinimumSystemVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Only the bundle's icon.icns needs these -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Platforms/Desktop/macOS/AppIcon/**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Nerdbank.GitVersioning stamps the app version for iOS, Android and Windows, but not for the macOS bundle. -->
    <Target Name="SetMacOSBundleVersion"
            Condition="'$(IsDesktop)' == 'true'"
            BeforeTargets="_UnoPublishAppBundle"
            DependsOnTargets="GetBuildVersion">
        <PropertyGroup>
            <ApplicationVersion>$(BuildVersionSimple)</ApplicationVersion>
            <ApplicationDisplayVersion>$(BuildVersionSimple)</ApplicationDisplayVersion>
        </PropertyGroup>
        <!--
          Uno builds icon.icns only from images named icon16x16@1x and so on, and the desktop icon is icon_transparent.
          The Mac gets its own plated icon anyway, from assets/app-icon/export-macos-icon.cs.
        -->
        <ItemGroup>
            <_UnoResizetizerCollectedImages Include="$(MSBuildThisFileDirectory)Platforms/Desktop/macOS/AppIcon/*.png" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!-- The test project drives a few internal test seams (the search debounce, for one). -->
        <InternalsVisibleTo Include="DailyPlants.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    </ItemGroup>

    <ItemGroup>
      <UnoImage Update="Assets\AppLogo.svg" Link="Assets\Svg\applogo.svg" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="Assets\Svg\applogo.svg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- Tile/splash images referenced by Package.appxmanifest; Uno's default png glob skips the WinAppSDK head -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
      <Content Include="Platforms\Windows\**\*.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
