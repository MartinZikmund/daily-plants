<Project>

    <!--
        Dev-channel icon and splash: the prod artwork with a DEV badge stamped on at build time, so an app only ever
        supplies prod artwork. Opt out with -p:GenerateDevAssets=false.

        See "Dev artwork" in docs/releasing.md.
    -->

    <!-- CI builds (a staging deployment, say) read "CI" in blue instead of "DEV" in gold, so they're never mistaken for a
         local build. Preview either locally with -p:DevBadgeLabel=CI or DEV. -->
    <PropertyGroup>
        <DevBadgeLabel Condition="'$(DevBadgeLabel)' == '' and ('$(CI)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true')">CI</DevBadgeLabel>
        <DevBadgeLabel Condition="'$(DevBadgeLabel)' == ''">DEV</DevBadgeLabel>

        <!-- The in-app title-bar badge follows the same label (AppEnvironment.IsCiBuild). -->
        <DefineConstants Condition="'$(AppChannel)' == 'Dev' and '$(DevBadgeLabel)' == 'CI'">$(DefineConstants);APP_CI_BUILD</DefineConstants>
    </PropertyGroup>

    <UsingTask TaskName="ComposeDevAsset"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <Task>
            <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)DevAssets.Task.cs" />
        </Task>
    </UsingTask>

    <!--
        Evaluation is left alone: Uno.Sdk only creates UnoIcon / UnoSplashScreen when their files exist at evaluation
        time, which a build-generated file never does. The items are re-pointed here instead, just before Resizetizer
        collects them.

        Copies land in devassets/<content hash>/<original file name>. The hash because Resizetizer doesn't notice a
        changed file at an unchanged path; the original name because Resizetizer derives resource names from it.
    -->
    <Target Name="GenerateDevAssets"
            BeforeTargets="UnoResizetizeCollectItems"
            Condition="'$(AppChannel)' == 'Dev' and '$(GenerateDevAssets)' != 'false'">

        <ComposeDevAsset Condition="'@(UnoIcon)' != ''"
                         Assets="@(UnoIcon)"
                         Kind="Icon"
                         Label="$(DevBadgeLabel)"
                         TargetPlatform="$(TargetPlatformIdentifier)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         OutputRoot="$(IntermediateOutputPath)devassets">
            <Output TaskParameter="Result" ItemName="_DevAssetIcon" />
        </ComposeDevAsset>

        <ComposeDevAsset Condition="'@(UnoSplashScreen)' != ''"
                         Assets="@(UnoSplashScreen)"
                         Kind="Splash"
                         Label="$(DevBadgeLabel)"
                         TargetPlatform="$(TargetPlatformIdentifier)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         OutputRoot="$(IntermediateOutputPath)devassets">
            <Output TaskParameter="Result" ItemName="_DevAssetSplash" />
        </ComposeDevAsset>

        <ItemGroup Condition="'@(_DevAssetIcon)' != ''">
            <UnoIcon Remove="@(UnoIcon)" />
            <UnoIcon Include="@(_DevAssetIcon)" />
        </ItemGroup>

        <ItemGroup Condition="'@(_DevAssetSplash)' != ''">
            <UnoSplashScreen Remove="@(UnoSplashScreen)" />
            <UnoSplashScreen Include="@(_DevAssetSplash)" />
        </ItemGroup>
    </Target>

    <!--
        Windows tiles, taskbar icons and splash, for apps whose Package.appxmanifest points at a hand-made PNG set
        instead of Resizetizer's. Set DevWindowsAssetsExporter to the script that renders that set from one SVG
        (run with dotnet run, given the SVG and an output folder) and DevWindowsAssetsArt to that SVG. Dev builds run
        it on a badged copy of the art and swap the PNG Content items under DevWindowsAssetsFolder for its output,
        keeping their package paths. Prod ships the checked-in PNGs.
    -->
    <PropertyGroup>
        <DevWindowsAssetsFolder Condition="'$(DevWindowsAssetsFolder)' == ''">Platforms\Windows\</DevWindowsAssetsFolder>
    </PropertyGroup>

    <!--
        The badged copies are newer than the checked-in PNGs, so PreserveNewest would keep them in the output of a Prod
        build that follows a Dev one. Runs on every channel for that reason.
    -->
    <Target Name="CopyWindowsPackageImagesIfDifferent"
            BeforeTargets="AssignTargetPaths"
            Condition="'$(TargetPlatformIdentifier)' == 'windows' and '$(DevWindowsAssetsExporter)' != ''">
        <ItemGroup>
            <Content Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(Identity)').Replace('/', '\').StartsWith('$(DevWindowsAssetsFolder)', System.StringComparison.OrdinalIgnoreCase))">
                <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>

    <Target Name="GenerateDevWindowsAssets"
            BeforeTargets="AssignTargetPaths"
            DependsOnTargets="CopyWindowsPackageImagesIfDifferent;_ComposeDevWindowsArt;_ExportDevWindowsAssets"
            Condition="'$(AppChannel)' == 'Dev' and '$(GenerateDevAssets)' != 'false' and '$(TargetPlatformIdentifier)' == 'windows' and '$(DevWindowsAssetsExporter)' != ''">

        <ItemGroup Condition="'$(_DevWindowsAssetsDir)' != ''">
            <_DevWindowsAsset Include="@(Content)"
                              Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(Identity)').Replace('/', '\').StartsWith('$(DevWindowsAssetsFolder)', System.StringComparison.OrdinalIgnoreCase))" />
            <_DevWindowsAsset>
                <Link>%(Identity)</Link>
            </_DevWindowsAsset>
            <_DevWindowsAssetBadged Include="@(_DevWindowsAsset->'$(_DevWindowsAssetsDir)%(Filename)%(Extension)')" />
            <_DevWindowsAssetMissing Include="@(_DevWindowsAssetBadged)" Condition="!Exists('%(FullPath)')" />
            <_DevWindowsAssetBadged Remove="@(_DevWindowsAssetMissing)" />
        </ItemGroup>

        <Warning Condition="'@(_DevWindowsAssetMissing)' != ''"
                 Code="DEVASSETS004"
                 Text="$(DevWindowsAssetsExporter) didn't render @(_DevWindowsAssetMissing->'%(Filename)%(Extension)', ', '), so Dev ships those unbadged." />

        <ItemGroup Condition="'@(_DevWindowsAssetBadged)' != ''">
            <Content Remove="@(_DevWindowsAssetBadged->'%(Link)')" />
            <Content Include="@(_DevWindowsAssetBadged)" />
        </ItemGroup>
    </Target>

    <Target Name="_ComposeDevWindowsArt">
        <ItemGroup>
            <_DevWindowsArt Include="$(DevWindowsAssetsArt)" />
        </ItemGroup>

        <Error Condition="'@(_DevWindowsArt)' == '' or !Exists('$(DevWindowsAssetsArt)')"
               Text="DevWindowsAssetsExporter is set, but DevWindowsAssetsArt ('$(DevWindowsAssetsArt)') isn't an existing SVG." />

        <!-- Kind=Splash only means "replace the item spec"; on Windows the badge sits flush bottom-centre, unmasked. -->
        <ComposeDevAsset Assets="@(_DevWindowsArt)"
                         Kind="Splash"
                         Label="$(DevBadgeLabel)"
                         TargetPlatform="$(TargetPlatformIdentifier)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         OutputRoot="$(IntermediateOutputPath)devassets">
            <Output TaskParameter="Result" ItemName="_DevWindowsBadgedArt" />
        </ComposeDevAsset>

        <!-- A copy under its own hash folder; anything else means the badge was skipped (DEVASSETS001). -->
        <PropertyGroup Condition="'@(_DevWindowsBadgedArt->'%(FullPath)')' != '@(_DevWindowsArt->'%(FullPath)')'">
            <_DevWindowsBadgedArtFile>@(_DevWindowsBadgedArt->'%(FullPath)')</_DevWindowsBadgedArtFile>
            <_DevWindowsAssetsOut>@(_DevWindowsBadgedArt->'%(RootDir)%(Directory)')windows</_DevWindowsAssetsOut>
            <_DevWindowsAssetsDir>$(_DevWindowsAssetsOut)\</_DevWindowsAssetsDir>
        </PropertyGroup>
    </Target>

    <Target Name="_ExportDevWindowsAssets"
            DependsOnTargets="_ComposeDevWindowsArt"
            Condition="'$(_DevWindowsAssetsDir)' != ''"
            Inputs="$(_DevWindowsBadgedArtFile);$(DevWindowsAssetsExporter)"
            Outputs="$(_DevWindowsAssetsDir)export.stamp">
        <PropertyGroup>
            <_DevWindowsDotnet>$(DOTNET_HOST_PATH)</_DevWindowsDotnet>
            <_DevWindowsDotnet Condition="'$(_DevWindowsDotnet)' == ''">dotnet</_DevWindowsDotnet>
        </PropertyGroup>

        <RemoveDir Directories="$(_DevWindowsAssetsDir)" />
        <Exec Command="&quot;$(_DevWindowsDotnet)&quot; run &quot;$(DevWindowsAssetsExporter)&quot; -- &quot;$(_DevWindowsBadgedArtFile)&quot; &quot;$(_DevWindowsAssetsOut)&quot;"
              WorkingDirectory="$([System.IO.Path]::GetDirectoryName($(DevWindowsAssetsExporter)))"
              StandardOutputImportance="low" />
        <Touch Files="$(_DevWindowsAssetsDir)export.stamp" AlwaysCreate="true" />
    </Target>

    <!--
        Resizetizer's Android adaptive-icon generator treats its output as up to date whenever it is newer than the
        foreground FILE, so switching to an older foreground (Dev -> Prod, or back to a reused badged copy) keeps the
        previous icon. When the foreground or its scale changes, clear that output and the stamp that would skip it.
        Runs on every channel: the Prod build after a Dev build is exactly the case that needs it.
    -->
    <Target Name="InvalidateStaleAndroidAppIcons"
            BeforeTargets="UnoResizetizeImages"
            Condition="'$(TargetPlatformIdentifier)' == 'android'">
        <PropertyGroup>
            <_AppIconStateFile>$(IntermediateOutputPath)devassets.appicon.state</_AppIconStateFile>
            <_AppIconState>@(UnoIcon->'%(ForegroundFile)|%(ForegroundScale)|%(AndroidForegroundScale)')</_AppIconState>
            <_PreviousAppIconState />
        </PropertyGroup>

        <ReadLinesFromFile File="$(_AppIconStateFile)" Condition="Exists('$(_AppIconStateFile)')">
            <Output TaskParameter="Lines" PropertyName="_PreviousAppIconState" />
        </ReadLinesFromFile>

        <RemoveDir Directories="$(_UnoIntermediateAppIcon)"
                   Condition="'$(_PreviousAppIconState)' != '$(_AppIconState)' and '$(_UnoIntermediateAppIcon)' != ''" />
        <Delete Files="$(_UnoResizetizerStampFile)"
                Condition="'$(_PreviousAppIconState)' != '$(_AppIconState)' and '$(_UnoResizetizerStampFile)' != ''" />

        <WriteLinesToFile File="$(_AppIconStateFile)" Lines="$(_AppIconState)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <FileWrites Include="$(_AppIconStateFile)" />
        </ItemGroup>
    </Target>

</Project>
